# Server
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Database
DATABASE_URL=postgres://user:password@localhost:5432/villagekeep

# Email (SMTP) — required for password reset & email verification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=VillageMembers <noreply@yourdomain.com>

# Stripe (add later)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Bunny.net CDN (add later)
# BUNNY_STORAGE_ZONE=villagekeep
# BUNNY_API_KEY=...
# BUNNY_CDN_URL=https://cdn.villagekeep.com
